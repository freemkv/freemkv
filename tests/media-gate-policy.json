{
  "schema": 4,
  "revision": 3,
  "libraries": ["libfreemkv", "freemkv-engine", "freemkv-keysources"],
  "library_required": ["src/**", "build.rs", "Cargo.toml"],
  "library_inert": [".github/**", "tests/**", "benches/**", "examples/**", "docs/**", "*.md", "*.rst",
                    "LICENSE*", "LICENSES/**", "NOTICE", "REUSE.toml", ".gitignore", "codecov.yml",
                    "deny.toml", "rustfmt.toml", "clippy.toml", "Makefile", "Cargo.lock"],
  "required_extra": {"freemkv-engine": ["USING_THE_ENGINE.md"]},
  "freemkv_required": ["src/pipe.rs", "src/keydb_fetch.rs", "src/file_identity.rs", "src/title_identity.rs", "src/disc_copy_verdict.rs", "src/sources.rs", "src/rip_keys.rs", "src/cli_stop.rs", "src/artifact_lock.rs", "src/plan_core.rs",
                       "build.rs", "res/freemkv.manifest"],
  "freemkv_modules": ["pipe", "keydb_fetch", "file_identity", "title_identity", "disc_copy_verdict", "sources", "rip_keys", "cli_stop", "artifact_lock", "plan_core"],
  "freemkv_crate_roots": ["src/main.rs", "src/lib.rs"],
  "control_plane": [".github/workflows/qa.yml", ".github/scripts/exact-toolchain.sh", ".github/runner-templates/**",
                    "tests/media_gate.py", "tests/media_perf.py", "tests/media_fetch.py", "tests/media_checks.py",
                    "tests/media_canary.py",
                    "tests/media-gate-policy.json", "tests/media-fetch-requirements.txt"],
  "gui_features": ["gui"],
  "rerun_exempt": {
    "libfreemkv": {".git/*": "GIT_SUFFIX stamp only; version metadata is excluded from comparison"},
    "freemkv": {"res/freemkv.ico": "icon: the Windows app icon resource, not code",
                ".git/*": "server build's GIT_SUFFIX stamp only; version metadata, not code"}
  },
  "allowed_crate_callees": {
    "cli_entry": "argument parsing (VALUE_FLAGS, is_flag_token); covered by cli-integration and hash-matrix",
    "disc_info": "info output; covered by cli-integration and hash-matrix",
    "ku_fixtures": "test-only key fixtures (cfg(test)); never in a release build",
    "lossy": "lossy-export report text; covered by cli-integration and hash-matrix",
    "messaging": "level/code messaging; covered by messaging_contract and cli-integration",
    "output": "terminal output; covered by cli-integration and hash-matrix",
    "strings": "i18n string facade; covered by cli-integration and hash-matrix"
  },
  "closure_roots": ["ureq", "mimalloc", "libc"],
  "closure_skip": ["freemkv-unlock", "freemkv-i18n"],
  "runner_name_re": "^ephemeral-(linux|windows)(-perf)?-(i-[0-9a-f]{8,17})$",
  "harness": {"repository": "freemkv/freemkv-ci", "sha": "0e5632dac795292c5575e8bee9f23b8ae334aeec"},
  "launch": {
    "linux": {"template": "freemkv-runner-linux", "types": ["c7i.4xlarge", "c6i.4xlarge", "m7i.4xlarge"],
              "spot_max_price": "0.72", "on_demand_fallback": true},
    "windows": {"template": "freemkv-runner-windows", "types": []}
  },
  "fixtures": ["dvd.iso", "bd.iso", "uhd.iso", "hddvd.iso", "keydb.cfg",
    "synthetic-m2ts-h264-bframes-lpcm16-lpcm24.m2ts", "synthetic-mkv-h264-aac-mp2-mp3.mkv", "synthetic-mpg-mpeg2-interlaced-mp2-lpcm24.mpg", "bd-aacs-damage.patch.json"],
  "canary": {"probes": [{"fixture": "uhd.iso"}]},
  "perf": {
    "enabled": false,
    "protocol": 1,
    "instance_type": "c6id.4xlarge",
    "root_volume_gib": 100,
    "titles": {},
    "repeats": 3,
    "thresholds": {"fail": 2.0, "warn_cpu": 1.3, "warn_mkv": 1.5, "rss_fail_mib": 256, "rss_warn_mib": 64,
                   "fast": 0.5, "calibration": [0.8, 1.25], "noise": 1.25},
    "drift_window": 5,
    "baseline_scan_cap": 50,
    "accept": [],
    "pinned_baseline": null
  },
  "max_age_days": 90
}
