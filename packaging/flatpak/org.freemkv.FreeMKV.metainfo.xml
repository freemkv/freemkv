<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the Flathub submission. The file's schema is
  what Flathub reviewers check on submission; if it fails
  `appstreamcli validate`, the submission bounces.

  License block covers this METADATA file only (CC0), not the app; the
  app itself is MIT (project::license below).
-->
<component type="desktop-application">
  <id>org.freemkv.FreeMKV</id>
  <name>freemkv</name>
  <summary>Rip DVD, Blu-ray and UHD discs to MKV, MP4 or M2TS</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="org.freemkv">
    <name>The freemkv project</name>
  </developer>

  <launchable type="desktop-id">org.freemkv.FreeMKV.desktop</launchable>

  <description>
    <p>
      freemkv is an open-source disc ripping tool for DVD, Blu-ray and
      Ultra HD Blu-ray. It derives the cryptographic keys a copy-protected
      disc uses (AACS), reads the video and audio streams, and writes them
      to MKV, MP4 or M2TS — or to a decrypted ISO / folder.
    </p>
    <p>Features:</p>
    <ul>
      <li>Rips DVD, Blu-ray and UHD Blu-ray discs.</li>
      <li>Preserves original quality — no re-encoding.</li>
      <li>Multi-pass reads recover from unreadable sectors.</li>
      <li>Selectable per-title audio and subtitle streams, with language filters.</li>
      <li>Same product on Linux, macOS and Windows.</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/user-attachments/assets/b7c6bfa7-7d39-4ab7-a422-9defba5649f6</image>
      <caption>Selecting titles and tracks before ripping a disc</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/user-attachments/assets/37e1d34d-91b7-4a17-a577-af740c4de979</image>
      <caption>Ripping a disc with progress and output information</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://freemkv.org</url>
  <url type="bugtracker">https://github.com/freemkv/freemkv/issues</url>
  <url type="donation">https://freemkv.org/donate</url>
  <url type="vcs-browser">https://github.com/freemkv/freemkv</url>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>

  <keywords>
    <keyword>disc</keyword>
    <keyword>dvd</keyword>
    <keyword>bluray</keyword>
    <keyword>uhd</keyword>
    <keyword>rip</keyword>
    <keyword>iso</keyword>
    <keyword>mkv</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#e0e0e0</color>
    <color type="primary" scheme_preference="dark">#2b2b2b</color>
  </branding>

  <!--
    Release history, newest first. release-orchestrate.yml stamps the real
    release date into the entry for the version it releases.
  -->
  <releases>
    <release version="1.8.3" date="2026-10-09"/>
    <release version="1.8.2" date="2026-10-08"/>
    <release version="1.8.1" date="2026-10-07"/>
    <release version="1.8.0" date="2026-10-05"/>
    <release version="1.7.6" date="2026-09-25">
      <description>
        <p>First Linux desktop release (GTK4 + libadwaita), in beta.</p>
      </description>
    </release>
  </releases>
</component>
