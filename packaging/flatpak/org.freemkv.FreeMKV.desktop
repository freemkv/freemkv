[Desktop Entry]
Type=Application
Name=freemkv
GenericName=Disc Ripper
Comment=Rip DVD, Blu-ray and UHD discs to MKV / MP4 / M2TS
Categories=AudioVideo;Video;
# A bare launch of the app build opens the window.
Exec=freemkv
Icon=org.freemkv.FreeMKV
Terminal=false
StartupNotify=true
StartupWMClass=org.freemkv.FreeMKV
# The Flatpak sandbox only exposes drives the manifest lets in; browsing
# the ISO/MKV file the user picked lands via GtkFileDialog + portals.
MimeType=application/x-cd-image;application/x-iso9660-image;video/x-matroska;
Keywords=disc;dvd;bluray;bd;uhd;rip;iso;mkv;
